# Copy this file to .env.local for local development.
# NEXT_PUBLIC_ variables are inlined into the client bundle at build time.

# Base URL of the animal-family-backend API, with no trailing path (the
# /api/v2 prefix comes from the OpenAPI contract). Must be an origin the
# backend's FRONTEND_URL / PRODUCTION_FRONTEND_URL allows for CORS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
